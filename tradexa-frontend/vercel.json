{
  "version": 2,
  "builds": [
    {
      "src": "tradexa-frontend/vite.config.js",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "tradexa-frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
